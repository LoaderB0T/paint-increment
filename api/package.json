{
  "name": "paint-increment-api",
  "private": true,
  "version": "1.0.0",
  "description": "Paint a picture incrementally with your friends",
  "license": "MIT",
  "author": {
    "name": "Janik Schumacher (LoaderB0T)",
    "url": "https://awdware.de"
  },
  "homepage": "https://github.com/LoaderB0T/paint-increment",
  "repository": {
    "type": "git",
    "url": "https://github.com/LoaderB0T/paint-increment.git"
  },
  "scripts": {
    "link-file": "tsx ./link-events.ts",
    "prebuild": "rimraf dist",
    "build": "nest build && pnpm copy:assets",
    "copy:assets": "cpy config.json dist && cpy web.config dist",
    "format": "oxfmt \"**/*.{ts,json,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,json,md}\"",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "pnpm migrate:up",
    "start:prod": "node dist/main",
    "migrate:base": "tsx node_modules/migrate-mongo/bin/migrate-mongo.js",
    "migrate:status": "pnpm migrate:base status -f migrate-mongo-config.ts",
    "migrate:create": "pnpm migrate:base create -f migrate-mongo-config.ts",
    "migrate:up": "pnpm migrate:base up -f migrate-mongo-config.ts",
    "migrate:undo-last": "pnpm migrate:base down -f migrate-mongo-config.ts && pnpm migrate:status"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "canvas": "3.2.3",
    "mongodb": "^7.6.0",
    "nanoid": "^6.0.1",
    "nodemailer": "^9.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "supertokens-node": "^21.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.1",
    "cpy-cli": "^7.0.0",
    "express": "^5.2.1",
    "fs-extra": "^11.4.0",
    "migrate-mongo": "^14.0.7",
    "npm-check-updates": "^23.1.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rimraf": "^6.1.3",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
